{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Summary of a gs-zec-validate compare-range run",
 "description": "`results` is identical for the same node data, revisions and tool version; `run` holds what varies. All amounts are integers in zatoshi. See docs/OPERATOR-TOOLS.md.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "matches_published",
  "problems",
  "published_results_sha256",
  "results",
  "results_sha256",
  "run",
  "verdict"
 ],
 "properties": {
  "results": {
   "$ref": "#/$defs/results"
  },
  "results_sha256": {
   "description": "sha256 of `results` serialised as JSON with sorted keys, separators ',' and ':', ASCII only.",
   "$ref": "#/$defs/hex64"
  },
  "published_results_sha256": {
   "type": [
    "string",
    "null"
   ]
  },
  "matches_published": {
   "type": [
    "boolean",
    "null"
   ]
  },
  "verdict": {
   "enum": [
    "pass",
    "fail"
   ]
  },
  "problems": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "run": {
   "description": "Facts about this run. Not part of the checksum. Holds no host name, user name or path.",
   "type": "object",
   "additionalProperties": false,
   "required": [
    "graphsense_lib_versions",
    "node",
    "platform",
    "python",
    "seconds",
    "started_utc",
    "worker_answers"
   ],
   "properties": {
    "started_utc": {
     "type": "string"
    },
    "seconds": {
     "type": "integer",
     "minimum": 0
    },
    "node": {
     "type": [
      "string",
      "null"
     ]
    },
    "python": {
     "type": "string"
    },
    "platform": {
     "type": "string"
    },
    "graphsense_lib_versions": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "after",
      "before"
     ],
     "properties": {
      "before": {
       "type": [
        "string",
        "null"
       ]
      },
      "after": {
       "type": [
        "string",
        "null"
       ]
      }
     }
    },
    "worker_answers": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "after",
      "before"
     ],
     "properties": {
      "before": {
       "type": "object",
       "additionalProperties": {
        "type": "integer",
        "minimum": 0
       }
      },
      "after": {
       "type": "object",
       "additionalProperties": {
        "type": "integer",
        "minimum": 0
       }
      }
     }
    }
   }
  }
 },
 "$defs": {
  "hex64": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  },
  "count": {
   "type": "integer",
   "minimum": 0
  },
  "zatoshi": {
   "type": "integer"
  },
  "tool": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "name",
    "version"
   ],
   "properties": {
    "name": {
     "const": "gs-zec-validate"
    },
    "version": {
     "type": "string",
     "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    }
   }
  },
  "range": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "blocks",
    "end",
    "start"
   ],
   "properties": {
    "start": {
     "type": "integer",
     "minimum": 0
    },
    "end": {
     "type": "integer",
     "minimum": 0
    },
    "blocks": {
     "type": "integer",
     "minimum": 1
    }
   }
  },
  "file_identity": {
   "type": [
    "object",
    "null"
   ],
   "additionalProperties": false,
   "required": [
    "git_blob",
    "sha256"
   ],
   "properties": {
    "git_blob": {
     "type": "string",
     "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
     "$ref": "#/$defs/hex64"
    }
   }
  },
  "revision": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "found",
    "is_pinned_code",
    "pinned"
   ],
   "properties": {
    "pinned": {
     "description": "The release the manifest pins for this side.",
     "type": "object",
     "additionalProperties": false,
     "required": [
      "git_commit",
      "package_tree_sha256",
      "version"
     ],
     "properties": {
      "version": {
       "type": "string"
      },
      "git_commit": {
       "type": "string",
       "pattern": "^[0-9a-f]{40}$"
      },
      "package_tree_sha256": {
       "$ref": "#/$defs/hex64"
      }
     }
    },
    "found": {
     "description": "The graphsenselib package that ran: checksum over all its files, and the accounting files.",
     "type": "object",
     "additionalProperties": false,
     "required": [
      "files",
      "package_file_count",
      "package_tree_sha256"
     ],
     "properties": {
      "package_tree_sha256": {
       "$ref": "#/$defs/hex64"
      },
      "package_file_count": {
       "type": "integer",
       "minimum": 0
      },
      "files": {
       "type": "object",
       "additionalProperties": {
        "$ref": "#/$defs/file_identity"
       }
      }
     }
    },
    "is_pinned_code": {
     "type": "boolean"
    }
   }
  },
  "settings": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "with_coinjoin_filter",
    "without_coinjoin_filter"
   ],
   "properties": {
    "without_coinjoin_filter": {
     "type": "integer",
     "minimum": 0
    },
    "with_coinjoin_filter": {
     "type": "integer",
     "minimum": 0
    }
   }
  },
  "txid": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  },
  "pool_totals": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "blocks",
    "into_pool",
    "out_of_pool",
    "transactions"
   ],
   "properties": {
    "blocks": {
     "type": "integer",
     "minimum": 0
    },
    "transactions": {
     "type": "integer",
     "minimum": 0
    },
    "out_of_pool": {
     "type": "integer",
     "minimum": 0
    },
    "into_pool": {
     "type": "integer",
     "minimum": 0
    }
   }
  },
  "results": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "canonical",
    "changed",
    "clustering_edges",
    "clustering_input_sets_changed",
    "coinjoin_flags",
    "differences_explained",
    "fees_of_non_coinbase_transactions",
    "newly_accounted",
    "range",
    "records_sha256",
    "relation_estimates",
    "revisions",
    "summary_format",
    "tool",
    "transactions",
    "unresolved_inputs"
   ],
   "properties": {
    "summary_format": {
     "const": 1
    },
    "tool": {
     "$ref": "#/$defs/tool"
    },
    "range": {
     "$ref": "#/$defs/range"
    },
    "canonical": {
     "type": "boolean",
     "description": "Both revisions are the pinned code."
    },
    "revisions": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "after",
      "before"
     ],
     "properties": {
      "before": {
       "$ref": "#/$defs/revision"
      },
      "after": {
       "$ref": "#/$defs/revision"
      }
     }
    },
    "transactions": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "coinbase",
      "non_coinbase",
      "total"
     ],
     "properties": {
      "total": {
       "type": "integer",
       "minimum": 0
      },
      "coinbase": {
       "type": "integer",
       "minimum": 0
      },
      "non_coinbase": {
       "type": "integer",
       "minimum": 0
      }
     }
    },
    "changed": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "blocks_with_changed_transactions",
      "coinbase_total_output",
      "fee",
      "input_count",
      "output_count",
      "total_input",
      "total_output",
      "transactions"
     ],
     "properties": {
      "transactions": {
       "type": "integer",
       "minimum": 0
      },
      "total_input": {
       "type": "integer",
       "minimum": 0
      },
      "total_output": {
       "type": "integer",
       "minimum": 0
      },
      "fee": {
       "type": "integer",
       "minimum": 0
      },
      "input_count": {
       "type": "integer",
       "minimum": 0
      },
      "output_count": {
       "type": "integer",
       "minimum": 0
      },
      "blocks_with_changed_transactions": {
       "type": "integer",
       "minimum": 0
      },
      "coinbase_total_output": {
       "type": "integer",
       "minimum": 0
      }
     }
    },
    "fees_of_non_coinbase_transactions": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "after",
      "before"
     ],
     "properties": {
      "before": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "negative",
        "zero"
       ],
       "properties": {
        "negative": {
         "type": "integer",
         "minimum": 0
        },
        "zero": {
         "type": "integer",
         "minimum": 0
        }
       }
      },
      "after": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "negative",
        "zero"
       ],
       "properties": {
        "negative": {
         "type": "integer",
         "minimum": 0
        },
        "zero": {
         "type": "integer",
         "minimum": 0
        }
       }
      }
     }
    },
    "newly_accounted": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "ironwood",
      "orchard"
     ],
     "properties": {
      "orchard": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "into_pool",
        "out_of_pool",
        "transactions"
       ],
       "properties": {
        "transactions": {
         "type": "integer",
         "minimum": 0
        },
        "out_of_pool": {
         "type": "integer",
         "minimum": 0
        },
        "into_pool": {
         "type": "integer",
         "minimum": 0
        }
       }
      },
      "ironwood": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "into_pool",
        "out_of_pool",
        "transactions"
       ],
       "properties": {
        "transactions": {
         "type": "integer",
         "minimum": 0
        },
        "out_of_pool": {
         "type": "integer",
         "minimum": 0
        },
        "into_pool": {
         "type": "integer",
         "minimum": 0
        }
       }
      }
     }
    },
    "coinjoin_flags": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "after",
      "before",
      "false_to_true",
      "flagged_transactions",
      "true_to_false"
     ],
     "properties": {
      "before": {
       "type": "integer",
       "minimum": 0
      },
      "after": {
       "type": "integer",
       "minimum": 0
      },
      "false_to_true": {
       "type": "integer",
       "minimum": 0
      },
      "true_to_false": {
       "type": "integer",
       "minimum": 0
      },
      "flagged_transactions": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "after",
        "before"
       ],
       "properties": {
        "before": {
         "type": "array",
         "items": {
          "$ref": "#/$defs/txid"
         }
        },
        "after": {
         "type": "array",
         "items": {
          "$ref": "#/$defs/txid"
         }
        }
       }
      }
     }
    },
    "clustering_input_sets_changed": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "multi_input_address_set",
      "spark_regular_inputs"
     ],
     "properties": {
      "multi_input_address_set": {
       "$ref": "#/$defs/settings"
      },
      "spark_regular_inputs": {
       "$ref": "#/$defs/settings"
      }
     }
    },
    "clustering_edges": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "after",
      "before"
     ],
     "properties": {
      "before": {
       "$ref": "#/$defs/settings"
      },
      "after": {
       "$ref": "#/$defs/settings"
      }
     }
    },
    "relation_estimates": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "absolute_change",
      "estimated_value_after_of_changed",
      "estimated_value_before_of_changed",
      "largest_change",
      "pairs_after",
      "pairs_before",
      "pairs_changed",
      "pairs_only_after",
      "pairs_only_before",
      "transactions_with_changed_pairs"
     ],
     "properties": {
      "pairs_before": {
       "type": "integer",
       "minimum": 0
      },
      "pairs_after": {
       "type": "integer",
       "minimum": 0
      },
      "pairs_changed": {
       "type": "integer",
       "minimum": 0
      },
      "pairs_only_before": {
       "type": "integer",
       "minimum": 0
      },
      "pairs_only_after": {
       "type": "integer",
       "minimum": 0
      },
      "transactions_with_changed_pairs": {
       "type": "integer",
       "minimum": 0
      },
      "estimated_value_before_of_changed": {
       "type": "integer",
       "minimum": 0
      },
      "estimated_value_after_of_changed": {
       "type": "integer",
       "minimum": 0
      },
      "absolute_change": {
       "type": "integer",
       "minimum": 0
      },
      "largest_change": {
       "type": "integer",
       "minimum": 0
      }
     }
    },
    "differences_explained": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "examples",
      "unexplained"
     ],
     "properties": {
      "unexplained": {
       "type": "integer",
       "minimum": 0
      },
      "examples": {
       "type": "array",
       "items": {
        "type": "string"
       }
      }
     }
    },
    "unresolved_inputs": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "after",
      "before"
     ],
     "properties": {
      "before": {
       "type": "integer",
       "minimum": 0
      },
      "after": {
       "type": "integer",
       "minimum": 0
      }
     }
    },
    "records_sha256": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "after",
      "before"
     ],
     "properties": {
      "before": {
       "$ref": "#/$defs/hex64"
      },
      "after": {
       "$ref": "#/$defs/hex64"
      }
     }
    }
   }
  }
 }
}
